{
  "elements": [
    {
      "type": "ValidationTextBox",
      "name": "host",
      "caption": "Hostname / IP-Adresse",
      "validate": "^[a-zA-Z0-9._-]+$"
    },
    {
      "type": "NumberSpinner",
      "name": "port",
      "caption": "Port",
      "minimum": 1,
      "maximum": 65535
    },
    {
      "type": "NumberSpinner",
      "name": "channels",
      "caption": "Anzahl Kanaele (PWM-Ausgaenge)",
      "minimum": 1,
      "maximum": 8
    },
    {
      "type": "NumberSpinner",
      "name": "update_interval",
      "caption": "Aktualisierungsintervall (Sekunden)",
      "minimum": 5,
      "suffix": "s"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Erweitert: Kanal-Skalierung (optional)",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Das Anzeige-Maximum (100% in der Kachel) wird normalerweise automatisch vom Geraet uebernommen (pwm#max je Kanal, kann je Kanal unterschiedlich sein). Fuer Kanaele mit geringem NUTZbereich (z.B. Mondlicht, das nur einen Bruchteil seines eigenen Maximums nutzt) kann hier optional ein eigener, kleinerer Wert erzwungen werden. 0 = automatisch (empfohlen)."
        },
        { "type": "NumberSpinner", "name": "ch1_max_pwm", "caption": "Kanal 1 – Anzeige-Maximum (0 = automatisch)", "minimum": 0, "maximum": 4095 },
        { "type": "NumberSpinner", "name": "ch2_max_pwm", "caption": "Kanal 2 – Anzeige-Maximum (0 = automatisch)", "minimum": 0, "maximum": 4095 },
        { "type": "NumberSpinner", "name": "ch3_max_pwm", "caption": "Kanal 3 – Anzeige-Maximum (0 = automatisch)", "minimum": 0, "maximum": 4095 },
        { "type": "NumberSpinner", "name": "ch4_max_pwm", "caption": "Kanal 4 – Anzeige-Maximum (0 = automatisch)", "minimum": 0, "maximum": 4095 },
        { "type": "NumberSpinner", "name": "ch5_max_pwm", "caption": "Kanal 5 – Anzeige-Maximum (0 = automatisch)", "minimum": 0, "maximum": 4095 },
        { "type": "NumberSpinner", "name": "ch6_max_pwm", "caption": "Kanal 6 – Anzeige-Maximum (0 = automatisch)", "minimum": 0, "maximum": 4095 },
        { "type": "NumberSpinner", "name": "ch7_max_pwm", "caption": "Kanal 7 – Anzeige-Maximum (0 = automatisch)", "minimum": 0, "maximum": 4095 },
        { "type": "NumberSpinner", "name": "ch8_max_pwm", "caption": "Kanal 8 – Anzeige-Maximum (0 = automatisch)", "minimum": 0, "maximum": 4095 }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Jetzt aktualisieren",
      "onClick": "SR8_RefreshWeatherPrograms($id); SR8_UpdateAll($id);"
    },
    {
      "type": "Label",
      "caption": "──────────────────────────────────────────────────"
    },
    {
      "type": "Label",
      "caption": "Tipp: Die Visualisierungs-Kachel (Variable 'Aquarium') ueber 4+ Spalten und 3+ Zeilen in der Tile-Visualization aufspannen fuer die beste Darstellung. Ueber das '⚙ Einstellungen'-Feld in der Kachel koennen pro Kanal Wetterprofil und ein temporaerer Test-PWM-Wert gesetzt werden."
    }
  ],
  "status": [
    { "code": 101, "icon": "inactive", "caption": "Instanz wird erstellt" },
    { "code": 102, "icon": "active",   "caption": "Verbunden" },
    { "code": 200, "icon": "error",    "caption": "Fehler – Details im IPS-Log" },
    { "code": 201, "icon": "inactive", "caption": "Nicht konfiguriert – Hostname eintragen" }
  ]
}
